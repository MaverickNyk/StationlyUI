<?xml version="1.0" encoding="utf-8"?>
<!--
     The board arriving after a REFRESH the user asked for.

     The same PACE as the left/right slide (owner, 2026-11-21: the refresh
     "happens very quick" beside the arrows). The slide carries the board its
     full width in 200ms; this used to move it a third of its height with a
     150ms fade, which read as a blink rather than a motion. Now it is a full
     vertical travel at a matching speed, the new board rolling up from below
     as the old one rolls out above, one surface like a split-flap turning over.
     Vertical is what keeps it from meaning "another platform": the slide is
     horizontal. No fade, because two boards never overlap on a full travel.

     Only ever played when a finger hit the refresh button (see WidgetMotion).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="260"
        android:fromYDelta="100%p"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toYDelta="0" />
</set>
