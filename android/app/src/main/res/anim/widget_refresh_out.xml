<?xml version="1.0" encoding="utf-8"?>
<!--
     The board leaving on a REFRESH: rolls up and out, the mirror of
     widget_refresh_in, same distance and duration so the pair reads as one
     surface moving (the way widget_page_out mirrors widget_page_in).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="260"
        android:fromYDelta="0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toYDelta="-100%p" />
</set>
