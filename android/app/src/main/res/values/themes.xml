<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Stationly" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/stationly_primary</item>
        <item name="colorPrimaryContainer">@color/stationly_primary_container</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/stationly_secondary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">#1E1E1E</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">#000000</item>
        
        <!-- App bar color -->
        <item name="colorSurfaceVariant">@color/stationly_surface</item>
    </style>

    <!-- Splash screen — dark field with the red Stationly roundel centered. -->
    <style name="Theme.Stationly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Stationly</item>
    </style>
</resources>