<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Stationly" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/stationly_primary</item>
        <item name="colorPrimaryContainer">@color/stationly_primary_container</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/stationly_secondary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/stationly_primary</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/white</item>
        
        <!-- App bar color -->
        <item name="colorSurfaceVariant">@color/stationly_surface</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Stationly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/stationly_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Stationly</item>
    </style>
</resources>