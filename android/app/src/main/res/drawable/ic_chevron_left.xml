<?xml version="1.0" encoding="utf-8"?>
<!--
     The platform pager's back arrow, drawn for a dot-matrix board.

     Two things here are load-bearing and neither is obvious.

     THE VIEWPORT IS THE INK. The Material chevron this replaced drew 7 units
     of ink inside a 24-unit viewport, and `fitCenter` fits the BOX to the view,
     not the ink: the arrow came out 4.6dp wide in a 34dp button, measured on
     the device, a hairline adrift in the middle of its own padding. This path
     fills its viewport to the edge (x 0.3..9.9, y 0.3..15.7 of a 10x16 box),
     so the arrow is exactly as big as the space given to it, and
     `widget_departure_board.xml` can line its left edge up with the departure
     rows' 4dp text inset by arithmetic rather than by eye.

     SQUARE CAPS, MITRED JOIN. A board drawn in amber pixels has no round ends
     and no antialiased curves; a rounded chevron reads as a Material icon
     button dropped onto the board rather than as part of it. The stroke is 3
     units of a 10-unit viewport — 30% — to carry the same weight as the 15sp
     bold row text beside it, because a thin arrow next to bold text reads as
     disabled.

     10x16 rather than square: this is the aspect the arrow actually occupies,
     so `fitCenter` has nothing left over to centre and the glyph lands where
     the padding says it does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="10dp"
    android:height="16dp"
    android:viewportWidth="10"
    android:viewportHeight="16"
    android:tint="@color/tfl_amber">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M7.8,2.4 L2.4,8 L7.8,13.6"
        android:strokeColor="@android:color/white"
        android:strokeWidth="3"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
</vector>
