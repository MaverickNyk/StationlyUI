<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon drawable for the Android 12+ Splash Screen API.
  The outer 288dp transparent canvas gives the API real intrinsic dimensions
  to render against; the inner 140dp bitmap is the visible Stationly roundel.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="center">
        <bitmap android:src="@drawable/stationly_logo" />
    </item>
</layer-list>
