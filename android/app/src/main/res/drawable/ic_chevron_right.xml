<?xml version="1.0" encoding="utf-8"?>
<!--
     The platform pager's forward arrow. The mirror of `ic_chevron_left` about
     x = 5, and everything written there applies here — the viewport is the ink,
     the caps are square and the join is mitred, because this is a departure
     board and not a Material icon set.

     The path is the left one's reflected about x = 5 to the decimal, not
     redrawn by hand. The two sit at opposite ends of the same row where the
     eye compares them directly, and an arrow half a unit heavier than its
     partner reads as a rendering fault rather than as a style.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="10dp"
    android:height="16dp"
    android:viewportWidth="10"
    android:viewportHeight="16"
    android:tint="@color/tfl_amber">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M2.2,2.4 L7.6,8 L2.2,13.6"
        android:strokeColor="@android:color/white"
        android:strokeWidth="3"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
</vector>
