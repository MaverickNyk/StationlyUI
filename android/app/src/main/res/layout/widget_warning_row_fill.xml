<?xml version="1.0" encoding="utf-8"?>
<!--
     `widget_departure_row_fill` for a closure's title: the text is as wide as its
     words, so that the warning signs sit beside them and not at the widget's edges.
     Same view ids, so every setter drives both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/departure_row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="22dp"
    android:layout_marginTop="2dp"
    android:background="@drawable/departure_board_active_row_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/destination_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/tfl_amber"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/eta_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
