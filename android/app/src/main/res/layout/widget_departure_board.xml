<?xml version="1.0" encoding="utf-8"?>
<!-- ── The root: fills its cell, and is the widget's BACKGROUND ──────────────

     `match_parent` height is the Android 17 fix. Every rows container below is
     0dp + weight 1, which only gets space inside a parent of FIXED height. A
     launcher that measures the widget "at most" this tall (seen on a Xiaomi
     after the Android 17 update, 2026-11) let a `wrap_content` root shrink to
     its fixed parts, so the header, status and clock drew and the departures
     got zero height.

     `@android:id/background` is how an Android 12+ launcher finds the
     background to crop to the SYSTEM corner shape, the same radius and
     smoothing its own widgets use, which follows OS updates by itself. Without
     it every launcher guessed, and the corners came out cut square on top.
     `clipToOutline` with the rounded background keeps the corner on launchers
     that do not crop. Padding is 10dp so the gear and refresh stay clear of a
     ~28dp system corner (anything nearer than ~0.29 r is cut). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_board_background"
    android:clipToOutline="true">

    <!-- The board itself. Everything visible lives in here, at its original
         sizes; the root only stacks it under the tap zones below. -->
    <LinearLayout
        android:id="@+id/board_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!-- No padding at ALL, on purpose: the board is full bleed, as the iOS
             one is ("the dot-matrix board must cover the widget end to end").
             Sides (owner, 2026-11-22): every row's lit background runs to the
             widget's edges, with 12dp text insets inside the rows. Top and
             bottom (owner, 2026-11-23): the station row starts at the top edge
             and the clock row ends at the bottom one. The corner clearance the
             old 10dp bought lives INSIDE those two rows as padding, so their
             lit backgrounds reach the corners while their contents stay clear. -->

    <!-- Top Header Row — full-width active background, name centered, buttons right -->
    <FrameLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/departure_board_active_row_background"
        android:paddingTop="7dp"
        android:paddingBottom="5dp">
        <!-- 7/5dp, not 2/2: this row now touches the top edge, so the padding
             is what keeps the gear and refresh glyphs inside the system corner
             curve. Top-heavy because only the TOP edge has a corner. -->

        <!-- Centered station lockup: mode roundel + station name. The icon
             carries the transport-mode identity (tube/overground/DLR/bus/
             tram/Elizabeth/National Rail) via its tint, distinguishing the
             station strip from the platform row below. Renderer in
             DepartureWidgetProvider / DreamBoard sets the icon tint per
             selection.mode. Margins reserve room for the refresh+settings
             cluster on the right. -->
        <LinearLayout
            android:id="@+id/station_lockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/mode_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/mode_roundel"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/line_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/tfl_amber"
                android:textSize="16.5sp"
                android:textStyle="bold"
                tools:text="Arsenal Underground Station" />
        </LinearLayout>

        <!-- ── Settings LEFT, refresh RIGHT, at their ORIGINAL size ──────────
             The icons keep the 32x26dp boxes the header was built around, so
             the header row does not grow. What grew is where a tap lands: the
             transparent zones at the bottom of this file. The two icons sit in
             opposite corners (the name is centred, so the left was empty) so
             their zones never touch.

             The spinner shares refresh's fixed box. Letting it fill the header
             height let its larger intrinsic size push the header taller on
             every refresh (owner, 2026-11-21). -->
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:contentDescription="Widget settings"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />

        <FrameLayout
            android:id="@+id/header_buttons"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:contentDescription="Refresh"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/progress_refresh"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateBehavior="repeat"
                android:indeterminateDuration="800"
                android:indeterminateDrawable="@drawable/ic_refresh_spinning"
                android:interpolator="@android:anim/linear_interpolator" />
            <!-- 800ms a turn, linear and continuous: one smooth spin per
                 frame rather than the old 12-step tick (see
                 ic_refresh_spinning). Linear because an eased turn slows to a
                 near stop every revolution, which is the stop-and-go this
                 replaced. -->
        </FrameLayout>
    </FrameLayout>

    <!-- Funny Countdown / Message Area -->
    <LinearLayout
        android:id="@+id/waiting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/funny_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="false"
            android:ellipsize="end"
            android:textColor="@color/tfl_amber"
            android:textSize="15sp"
            tools:text="🚇 Wrangling the pigeons... " />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textColor="@color/tfl_amber"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="00:59" />
    </LinearLayout>

    <!-- ── Platform pager (PlatformNav.STEP only) ──────────────────────────
         One platform at a time, with a chevron either side of its name.

         It lives OUT here rather than inside the collection on purpose: a
         RemoteViews collection item cannot carry its own PendingIntent (only a
         fill-in merged into one template), and this widget's template already
         means "open the app". Chevrons inside the list would open the app
         instead of paging. Out here they get a real setOnClickPendingIntent.

         GONE in scroll mode, which is the default and what every widget did
         before this existed.

         ── This bar IS the platform header, it does not sit above one ───────
         In step mode `PlatformPages.body()` drops the `PlatformHeader` row and
         this bar names the platform instead, so the two have to occupy the
         same box or the whole board below shifts the moment anyone steps. It
         therefore copies `widget_platform_header.xml` exactly: 2dp top margin,
         the active-row background, a 2dp side inset, and a 15sp bold TextView
         left to decide the height on its own.

         The height is structural, not a number kept in step by hand. A
         horizontal LinearLayout measures its `match_parent` children AFTER it
         has settled its own `wrap_content` height, so the chevrons fill this
         row without ever being able to grow it, at any font scale. The first
         cut gave them a fixed 30dp box, which stood a third of a row proud of
         every other line on the board. Nothing in here may be given a height
         that can exceed the title's. -->
    <LinearLayout
        android:id="@+id/platform_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <!-- The arrow's ink lands 4dp in from the board, level with the
             destination text of every row under it: 2dp of bar inset plus 2dp
             of start padding here. That only holds while the glyph is the
             narrower constraint, which is what the 8dp-wide content box (28 -
             2 - 18) buys — `fitCenter` then has no width left over to centre
             the arrow in, so the padding decides where it sits instead of the
             drawable's aspect doing it.

             The other 18dp is dead space and is meant to be: it is the tap
             target, pointing INWARDS across the bar where there is nothing
             else to hit, so a thumb on a home screen gets 28dp to aim at while
             the arrow stays the size of a letter. Enlarging the glyph instead
             is what turns this back into a Material icon button. -->
        <ImageView
            android:id="@+id/btn_platform_prev"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Previous platform"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="42dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <!-- ── Title and "1/2", centred TOGETHER (iOS PlatformPagerHeader) ──
             The marker sits right after the platform name, a notch smaller
             and dimmer, and the pair is centred as one between the arrows.
             It used to be a fixed slot at the far right, balanced by a spacer
             on the left, which cost 56dp a 2x2 did not have: the name got
             ~10dp and the bar read only "1/2" (owner, 2026-11-23).

             The marker is never squeezed, as on iOS: the title is
             `wrap_content` WITH weight, which a LinearLayout shrinks first
             when the pair is wider than the room, so "Mildmay Plat. 2" gives
             way before "1/2" does. The fitter in the provider picks a rung
             that fits beside the marker, so that is only a backstop. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- The FrameLayout is what centres this pair; not a useless parent. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UselessParent">

                <TextView
                    android:id="@+id/platform_pager_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="InefficientWeight"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/tfl_amber"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- iOS: platform x 0.72, bold, amberDim. -->
                <TextView
                    android:id="@+id/platform_pager_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"
                    android:textColor="@color/tfl_amber_dim"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- The mirror of the back arrow: ink 4dp from the board's edge, level
             with the ETA column, and 18dp of inward padding doing the same job
             as its own tap target. -->
        <ImageView
            android:id="@+id/btn_platform_next"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Next platform"
            android:paddingStart="42dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Dynamic Rows Container (API < 31) -->
    <LinearLayout
        android:id="@+id/rows_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
        
    <!-- ── Stepping container (PlatformNav.STEP) ───────────────────────────
         One child per platform, cross-faded by `setDisplayedChild`.

         A separate container from `rows_list` rather than a mode of it: a
         ListView cannot animate a wholesale content swap, and a ViewFlipper
         cannot scroll. Each mode gets the widget that does its job, and exactly
         one of the two is ever VISIBLE.

         ── THREE flippers, which is what buys three animations ─────────────

         `setInAnimation` is not a @RemotableViewMethod, so a flipper's in/out
         pair is fixed when this file is inflated and cannot be chosen per tap.
         One flipper therefore means one animation for every kind of change,
         which is how "next platform", "previous platform" and "refresh" all
         ended up as the same apologetic cross-fade.

         So there are three, stacked in the same slot with exactly one VISIBLE.
         A GONE child takes no weight, so the visible one fills the row whichever
         it is. An update picks a motion by picking a flipper, writes the
         outgoing frame and the incoming frame into it, and shows it — and
         because the outgoing frame is a fresh copy of what is already on screen,
         the swap between flippers is invisible.

         `animateFirstView="false"` is load-bearing and not tidiness. Without it
         `ViewAnimator.showOnly` animates the FIRST child shown after a
         `removeAllViews`, so every ambient redraw — every push, every minute
         tick, every one of the dozens a single refresh used to fan out — played
         the in-animation. That is what the owner saw as "multiple flashes", and
         no amount of scoping the redraws could fix it, because one redraw was
         already one flash. With it off, a plain render is silent and only a
         deliberate second `setDisplayedChild` moves anything.

         The chevrons are 52dp wide and their INK is 10dp. The glyph did not
         grow; the TARGET did. A miss on a home-screen widget does not do
         nothing: it falls through to the board (`@android:id/background`), whose click opens the
         app, so an arrow a fraction too small does the OPPOSITE of what it
         says. The extra width is asymmetric padding pointing INWARD, across the
         bar where there is nothing else to hit, so the ink stays in the board's
         text column while the target reaches most of the way to the title. -->
    <ViewFlipper
        android:id="@+id/platform_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_page_in"
        android:outAnimation="@anim/widget_page_out"
        android:visibility="gone" />

    <!-- The same slot, stepping BACKWARDS. -->
    <ViewFlipper
        android:id="@+id/platform_flipper_prev"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_page_back_in"
        android:outAnimation="@anim/widget_page_back_out"
        android:visibility="gone" />

    <!-- The same slot, on a refresh the user asked for. No inAnimation: the
         arriving page is widget_platform_page_refresh, whose ROWS roll in one
         after another; the old board only fades (owner, 2026-11-23). -->
    <ViewFlipper
        android:id="@+id/platform_flipper_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:outAnimation="@anim/widget_refresh_out"
        android:visibility="gone" />

    <!-- Native Scrolling Container (API >= 31) -->
    <ListView
        android:id="@+id/rows_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarSize="3dp"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="1500"
        android:scrollbarDefaultDelayBeforeFade="600" />

    <!-- Line Status Row -->
    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:visibility="gone">
        <!-- 3dp top and bottom (owner, 2026-11-23): with none, the 12sp marquee
             was a sliver between a full departure row and the footer. -->

        <TextView
            android:id="@+id/status_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Part Closure" />

        <TextView
            android:id="@+id/status_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textColor="@color/tfl_amber"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:freezesText="true"
            android:scrollHorizontally="true"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            tools:text="Service status reason text goes here...">
            <requestFocus />
        </TextView>
    </LinearLayout>

    <!-- The footer is a lit row like every other, flush to the bottom edge
         (owner, 2026-11-23), matching iOS's `DotMatrixFooter` LitCell. It was
         bare panel with only the clock lit, which left an unlit band under the
         board. 2dp gap like every row; bottom-heavy padding because the
         bottom corners are where the logo and "ago" sit. Kept tight
         (2/3dp): the clock's own line height already makes this the deepest
         row, and more padding made it read as heavier than the station row
         it is meant to bookend (owner, 2026-11-23). -->
    <RelativeLayout
        android:id="@+id/footer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/departure_board_active_row_background"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Stationly maker mark on the left, vertically centred on the
             footer row alongside the ticking clock + chronometer. Drawn
             at full opacity so the brand reads crisply against the dark
             dot-matrix panel. 20dp: enough pixel weight to look intentional
             rather than smudged, and clear of the bottom-left corner curve now
             the footer is flush to the edge. -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/stationly_logo"
            android:contentDescription="Stationly" />

        <!-- 24-hour in BOTH formats, on purpose. The in-app board and the
             screensaver always print 24-hour, as TfL boards do; following the
             phone's 12-hour setting made the widget read "09:03:50 PM" beside
             an app reading "21:03:50" (2026-11-21). -->
        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/tfl_amber"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="17:23:42" />

        <Chronometer
            android:id="@+id/last_updated_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            android:textStyle="italic"
            android:format="%s ago" />
    </RelativeLayout>

    </LinearLayout>

    <!-- ── Tap zones: bigger targets, same rows ───────────────────────────
         The owner asked for a bigger TOUCH area, not bigger rows (2026-11-21).
         A RemoteViews view only receives taps inside its own bounds, so the
         icons cannot reach further than the row they sit in. These transparent
         zones sit ON TOP of the board and carry the same PendingIntents as the
         controls under them, so a thumb that lands near an icon does what the
         icon says instead of falling through to the board (which opens the app).

         Geometry follows the board's fixed parts: the 38dp header (7dp + 26dp
         + 5dp, flush to the top), then the 2dp gap and the pager bar. These
         are the natural sizes; on Android 12+ `applyProportions` moves the
         zones with the rows when the board stretches. The chevron zones take
         the bar and a few dp of the row under it. Settings LEFT, refresh RIGHT: their zones never
         touch, so one cannot be mistaken for the other. The chevron zones are
         GONE outside step mode, so they never cover a scrolling list. -->
    <FrameLayout
        android:id="@+id/zone_settings"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:contentDescription="Widget settings" />

    <FrameLayout
        android:id="@+id/zone_refresh"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:contentDescription="Refresh" />

    <FrameLayout
        android:id="@+id/zone_platform_prev"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="40dp"
        android:contentDescription="Previous platform"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/zone_platform_next"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:contentDescription="Next platform"
        android:visibility="gone" />

</FrameLayout>
