<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/departure_board"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/departure_board_unlit_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@drawable/departure_board_active_row_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/stationly_logo"
                android:contentDescription="Stationly" />

            <TextView
                android:id="@+id/line_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tfl_amber"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Arsenal Underground Station" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Settings"
            android:padding="2dp"
            android:src="@drawable/ic_settings" />
    </RelativeLayout>

    <!-- Funny Countdown / Message Area -->
    <LinearLayout
        android:id="@+id/waiting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/funny_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="false"
            android:ellipsize="end"
            android:textColor="@color/tfl_amber"
            android:textSize="15sp"
            tools:text="🚇 Wrangling the pigeons... " />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textColor="@color/tfl_amber"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="00:59" />
    </LinearLayout>

    <!-- Dynamic Rows Container (API < 31) -->
    <LinearLayout
        android:id="@+id/rows_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
        
    <!-- Native Scrolling Container (API >= 31) -->
    <ListView
        android:id="@+id/rows_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:visibility="gone" />

    <!-- Line Status Row -->
    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/departure_board_active_row_background"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tfl_amber"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Part Closure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textColor="@color/tfl_amber"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:freezesText="true"
            android:scrollHorizontally="true"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:textColor="@color/tfl_amber"
            android:textSize="13sp"
            tools:text="Service status reason text goes here...">
            <requestFocus />
        </TextView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/departure_board_active_row_background"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/tfl_amber"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="17:23:42" />

        <Chronometer
            android:id="@+id/last_updated_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            android:textStyle="italic"
            android:format="%s ago" />
    </RelativeLayout>

</LinearLayout>
