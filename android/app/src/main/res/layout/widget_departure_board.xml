<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/departure_board"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/departure_board_unlit_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Row — full-width active background, name centered, buttons right -->
    <FrameLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/departure_board_active_row_background"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Centered station lockup: mode roundel + station name. The icon
             carries the transport-mode identity (tube/overground/DLR/bus/
             tram/Elizabeth/National Rail) via its tint, distinguishing the
             station strip from the platform row below. Renderer in
             DepartureWidgetProvider / DreamBoard sets the icon tint per
             selection.mode. Margins reserve room for the refresh+settings
             cluster on the right. -->
        <LinearLayout
            android:id="@+id/station_lockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/mode_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/mode_roundel"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/line_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxEms="18"
                android:textColor="@color/tfl_amber"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Arsenal Underground Station" />
        </LinearLayout>

        <!-- Buttons pinned to right -->
        <LinearLayout
            android:id="@+id/header_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:paddingEnd="4dp"
            android:orientation="horizontal">

            <!-- ── Target grows sideways only ──────────────────────────────
                 A miss here does not do nothing: it falls through to
                 `departure_board`, whose click opens the app, so an icon a
                 fraction too small launches Stationly instead of refreshing.

                 The first attempt at this was a 40dp box, and it broke two
                 things the owner saw immediately. It was TALLER than the 22dp
                 roundel beside it, so the whole header row grew; and two 40dp
                 boxes are 80dp, which overran the 68dp margin the station name
                 is centred inside, so the name ran under the refresh icon and
                 the icon appeared to drift towards the middle.

                 So the box is wide and short: 32dp across, which is what fits
                 (two of them plus the 4dp end padding is the 68dp the title
                 reserves), and 26dp tall, which is what the roundel already
                 makes the row. Height is where there was no room; width is
                 where there was. The glyph is 20dp in both, unchanged. -->
            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:contentDescription="Refresh"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <!-- Matches the refresh button it replaces exactly, so the header
                 does not jump the moment a fetch starts. -->
            <ProgressBar
                android:id="@+id/progress_refresh"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="#FFB900" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:contentDescription="Settings"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </FrameLayout>

    <!-- Funny Countdown / Message Area -->
    <LinearLayout
        android:id="@+id/waiting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/funny_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="false"
            android:ellipsize="end"
            android:textColor="@color/tfl_amber"
            android:textSize="15sp"
            tools:text="🚇 Wrangling the pigeons... " />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textColor="@color/tfl_amber"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="00:59" />
    </LinearLayout>

    <!-- ── Platform pager (PlatformNav.STEP only) ──────────────────────────
         One platform at a time, with a chevron either side of its name.

         It lives OUT here rather than inside the collection on purpose: a
         RemoteViews collection item cannot carry its own PendingIntent (only a
         fill-in merged into one template), and this widget's template already
         means "open the app". Chevrons inside the list would open the app
         instead of paging. Out here they get a real setOnClickPendingIntent.

         GONE in scroll mode, which is the default and what every widget did
         before this existed.

         ── This bar IS the platform header, it does not sit above one ───────
         In step mode `PlatformPages.body()` drops the `PlatformHeader` row and
         this bar names the platform instead, so the two have to occupy the
         same box or the whole board below shifts the moment anyone steps. It
         therefore copies `widget_platform_header.xml` exactly: 2dp top margin,
         the active-row background, a 2dp side inset, and a 15sp bold TextView
         left to decide the height on its own.

         The height is structural, not a number kept in step by hand. A
         horizontal LinearLayout measures its `match_parent` children AFTER it
         has settled its own `wrap_content` height, so the chevrons fill this
         row without ever being able to grow it, at any font scale. The first
         cut gave them a fixed 30dp box, which stood a third of a row proud of
         every other line on the board. Nothing in here may be given a height
         that can exceed the title's. -->
    <LinearLayout
        android:id="@+id/platform_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/departure_board_active_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <!-- The arrow's ink lands 4dp in from the board, level with the
             destination text of every row under it: 2dp of bar inset plus 2dp
             of start padding here. That only holds while the glyph is the
             narrower constraint, which is what the 8dp-wide content box (28 -
             2 - 18) buys — `fitCenter` then has no width left over to centre
             the arrow in, so the padding decides where it sits instead of the
             drawable's aspect doing it.

             The other 18dp is dead space and is meant to be: it is the tap
             target, pointing INWARDS across the bar where there is nothing
             else to hit, so a thumb on a home screen gets 28dp to aim at while
             the arrow stays the size of a letter. Enlarging the glyph instead
             is what turns this back into a Material icon button. -->
        <ImageView
            android:id="@+id/btn_platform_prev"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="28dp"
            android:contentDescription="Previous platform"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="42dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/platform_pager_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/tfl_amber"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- "1/2" is a fixed 28dp slot, and `btn_platform_prev` carries a 28dp
             end margin whose only job is to cancel it out. A weighted TextView
             centres in what is LEFT of the row, so a counter down one side
             alone drags the platform name off-centre by half its width: 9.3dp
             on the bar this replaces, measured on the device. Under a station
             name that is itself centred, and above rows that are, that is the
             kind of wrongness you see without being able to name it.

             Fixed rather than `wrap_content` for the same reason — a counter
             that grew with the page count would walk the title sideways as the
             user stepped. 28dp holds "10/12" at 11sp, and past that it clips
             rather than pushing, which is the right way round. -->
        <TextView
            android:id="@+id/platform_pager_count"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/tfl_amber"
            android:textSize="11sp" />

        <!-- The mirror of the back arrow: ink 4dp from the board's edge, level
             with the ETA column, and 18dp of inward padding doing the same job
             as its own tap target. -->
        <ImageView
            android:id="@+id/btn_platform_next"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Next platform"
            android:paddingStart="42dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Dynamic Rows Container (API < 31) -->
    <LinearLayout
        android:id="@+id/rows_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
        
    <!-- ── Stepping container (PlatformNav.STEP) ───────────────────────────
         One child per platform, cross-faded by `setDisplayedChild`.

         A separate container from `rows_list` rather than a mode of it: a
         ListView cannot animate a wholesale content swap, and a ViewFlipper
         cannot scroll. Each mode gets the widget that does its job, and exactly
         one of the two is ever VISIBLE.

         The animations are fixed here at inflate time because `setInAnimation`
         is not a @RemotableViewMethod. See widget_page_in.xml for why that
         rules out a directional slide.

         The chevrons are 52dp wide and their INK is 10dp. The glyph did not
         grow; the TARGET did. A miss on a home-screen widget does not do
         nothing: it falls through to `departure_board`, whose click opens the
         app, so an arrow a fraction too small does the OPPOSITE of what it
         says. The extra width is asymmetric padding pointing INWARD, across the
         bar where there is nothing else to hit, so the ink stays in the board's
         text column while the target reaches most of the way to the title. -->
    <ViewFlipper
        android:id="@+id/platform_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/widget_page_in"
        android:outAnimation="@anim/widget_page_out"
        android:visibility="gone" />

    <!-- Native Scrolling Container (API >= 31) -->
    <ListView
        android:id="@+id/rows_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarSize="3dp"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="1500"
        android:scrollbarDefaultDelayBeforeFade="600" />

    <!-- Line Status Row -->
    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/departure_board_active_row_background"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Part Closure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textColor="@color/tfl_amber"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:freezesText="true"
            android:scrollHorizontally="true"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            tools:text="Service status reason text goes here...">
            <requestFocus />
        </TextView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <!-- Stationly maker mark on the left, vertically centred on the
             footer row alongside the ticking clock + chronometer. Drawn
             at full opacity so the brand reads crisply against the dark
             dot-matrix panel; size bumped to 22dp so the disc has enough
             pixel weight to look intentional rather than smudged. -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:src="@drawable/stationly_logo"
            android:contentDescription="Stationly" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/departure_board_active_row_background"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/tfl_amber"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="17:23:42" />

        <Chronometer
            android:id="@+id/last_updated_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/tfl_amber"
            android:textSize="12sp"
            android:textStyle="italic"
            android:format="%s ago" />
    </RelativeLayout>

</LinearLayout>
