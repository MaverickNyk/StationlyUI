-- ⚠️ NO MIGRATIONS, DELIBERATELY. Wipe and reinstall instead.
--
-- ## The policy, decided 2026-08-23
-- The only thing being built right now is **iOS v1**, which has never shipped.
-- **Android is live (versionCode 2) and is FROZEN** — no new Android release is
-- planned, so nothing in this file can reach an Android user: the schema meets a
-- phone only when an APK ships, and the shipped APK carries its own old copy.
--
-- That makes migrations pure overhead. The schema is still moving daily while
-- the iOS app is finished, every `.sqm` is a file to keep in hand-sync with this
-- one, and the only databases in existence are on development devices.
--
--   **When you change this file, DELETE THE APP AND REINSTALL IT.**
--
-- `Schema.create` applies this file in full to an empty database, so a fresh
-- install is always correct by construction. Installing OVER an app keeps its
-- container and therefore its old database — that is what crashed the iOS build
-- on 2026-08-23 with "no such column". Delete the app first; boards come back
-- from the cloud on sign-in.
--
-- Migrations were briefly reinstated that day to rescue that install and were
-- removed again once it was clear no Android release was coming. If you find
-- yourself writing one, check that premise first — it is the only thing this
-- policy rests on.
--
-- ## What this defers, and what it costs
-- An Android database has never seen anything added here since its release. When
-- Android is eventually picked back up it needs ONE migration written against
-- the last released build, and the gap it must cross is everything below. **Keep
-- this list current when you add a column** — it is maintained by hand and is
-- the only record of what an Android upgrade owes.
--
--   CREATE TABLE ActivityEventEntity (…);  plus its index
--   ALTER TABLE UserSelectionEntity ADD COLUMN viaKeys               TEXT NOT NULL DEFAULT '';
--   ALTER TABLE UserSelectionEntity ADD COLUMN patternIds            TEXT NOT NULL DEFAULT '';
--   ALTER TABLE UserSelectionEntity ADD COLUMN patternNames          TEXT NOT NULL DEFAULT '';
--   ALTER TABLE UserSelectionEntity ADD COLUMN directionName         TEXT NOT NULL DEFAULT '';
--   ALTER TABLE UserSelectionEntity ADD COLUMN directionDestinations TEXT NOT NULL DEFAULT '';
--   ALTER TABLE UserSelectionEntity ADD COLUMN directionTowards      TEXT NOT NULL DEFAULT '';
--   ALTER TABLE PredictionEntity    ADD COLUMN viaKey                TEXT;
--
-- Write it as a table REBUILD, not a list of ALTERs — build the table in its
-- current shape under a temporary name, copy across, drop, rename. That lands on
-- the same result whatever the source database happened to contain, which
-- matters because "version 1" has meant several different schemas over time.

CREATE TABLE UserSelectionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mode TEXT NOT NULL,
    line TEXT NOT NULL,
    -- The naptan departures are FETCHED from: the resolved pole for this exact
    -- (line, direction). On bus these differ per direction — Smithwood Close
    -- resolves 39 inbound to 490008805N and outbound to 490012211N.
    station TEXT NOT NULL,
    -- The hub the user picked; cards GROUP on this so several poles render as
    -- one departure board. Blank means "same as station" (pre-hub rows).
    parentStationId TEXT NOT NULL DEFAULT '',
    stationName TEXT NOT NULL,
    direction TEXT NOT NULL,
    -- Every list column here is a JSON array of strings, written by
    -- `SqlStorage.encodeList`. NOT comma-joined: these hold stop NAMES, and one
    -- comma in a name splits an entry in two and shifts every later name onto
    -- the wrong id in the list beside it. Reads tolerate the old comma form.
    destinations TEXT NOT NULL,
    destinationIds TEXT NOT NULL,
    -- ALL | DESTINATIONS | VIA. Stored as the enum name rather than an ordinal
    -- so adding a filter kind can never renumber the existing ones; anything
    -- unrecognised decodes back to ALL (show everything).
    filterMode TEXT NOT NULL DEFAULT 'ALL',
    -- The station the user asked to travel through, preserved ALONGSIDE the
    -- resolved id list in destinationIds. The resolution goes stale when a
    -- branch closes, so the intent has to survive to be re-resolved.
    viaStationId TEXT,
    viaStationName TEXT,
    -- Branch tokens the departure's own viaKey must be one of ("bank",
    -- "charingcross"), CSV like the columns above. Part of the RESOLUTION, not
    -- the intent: re-derived every time the board is re-resolved.
    --
    -- Blank means "do not narrow by branch" and is the right answer for most of
    -- the network — only a line that splits AND rejoins needs it. Safe to store
    -- CSV: these are generated tokens, [a-z0-9] only, so unlike the stop-name
    -- columns above they can never contain a comma.
    viaKeys TEXT NOT NULL DEFAULT '',
    -- Whole services taken from the map's terminus chips, by pattern id, CSV.
    -- Intent rather than resolution: kept so reopening the sheet can show the
    -- branch as chosen instead of a stop in the middle of it.
    patternIds TEXT NOT NULL DEFAULT '',
    -- Display names for patternIds, index-aligned, as viaStationName is for
    -- viaStationId. A pattern id is unreadable, and the card has to name the
    -- filter without re-fetching route data to do it.
    patternNames TEXT NOT NULL DEFAULT '',
    -- What the picker CALLED this direction ("Southbound"), and every destination
    -- the direction serves. Both are route data the picker had and used to throw
    -- away, leaving the settings screen to show TfL's raw "inbound". Display
    -- only: nothing filters on either.
    directionName TEXT NOT NULL DEFAULT '',
    directionDestinations TEXT NOT NULL DEFAULT '',
    -- Where the direction heads, as the picker said it. The answer for anything
    -- with no compass bearing, which is every bus.
    directionTowards TEXT NOT NULL DEFAULT '',
    -- Epoch millis of the last resolution, so a stale allow-list can be found
    -- and refreshed without prompting the user again.
    routeResolvedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE PredictionEntity (
    stationId TEXT NOT NULL,
    lineId TEXT NOT NULL,
    -- Which direction of the line these departures belong to (lowercased,
    -- e.g. "westbound", "inner"). Part of the key because a user can track
    -- BOTH directions of one line at a station: without it, syncing the
    -- eastbound board would clear-and-replace the westbound board's rows
    -- (savePredictions deletes by station+line before inserting), so the two
    -- directions would overwrite each other on every stream frame.
    direction TEXT NOT NULL DEFAULT '',
    destination TEXT NOT NULL,
    -- Naptan id of the destination. Filters match on THIS, never on the
    -- display name: the route sequence says "Hammersmith (Dist&Picc Line)"
    -- where a prediction says "Hammersmith", so name comparison fails on
    -- precisely the short-terminating services a via-filter must catch.
    -- Not part of the primary key — it is an attribute of the train, and the
    -- existing key already identifies the row.
    destId TEXT NOT NULL DEFAULT '',
    -- Which BRANCH this train takes ("bank", "charingcross"), when TfL labels
    -- one. Stored rather than recomputed because `reapplyFilter` re-evaluates
    -- the filter against rows already on disk — when the user narrows a board
    -- the departures are not re-fetched — and without this it would have only
    -- destId to go on and would silently re-admit the trains the new filter
    -- exists to exclude. Null for every unbranched service.
    viaKey TEXT,
    -- Precomputed answer to "does this row pass the board's filter", written
    -- once at ingest. The board re-reads these rows on every recomposition and
    -- every one-second countdown tick, so the filter is evaluated per WRITE
    -- (once per stream frame) instead of per READ. Defaults to 1 so an
    -- unfiltered board behaves exactly as it did before.
    matchesFilter INTEGER NOT NULL DEFAULT 1,
    platform TEXT NOT NULL,
    eta TEXT NOT NULL,
    isDue INTEGER NOT NULL DEFAULT 0,
    stopLetter TEXT,
    timestamp INTEGER NOT NULL,
    -- Absolute wall-clock time the train is expected to arrive, in epoch
    -- millis. Stored alongside the formatted `eta` string so every consumer
    -- can derive an accurate minutes-remaining on its own clock without
    -- waiting for the next FCM tick. Nullable as a defensive fallback —
    -- if the FCM payload's ISO timestamp fails to parse, the column is
    -- null and consumers fall back to the stored `eta` string rather than
    -- dropping the row entirely.
    targetEpochMs INTEGER,
    PRIMARY KEY (stationId, lineId, direction, destination, platform, eta)
);

CREATE INDEX prediction_lookup ON PredictionEntity(stationId, lineId, direction);

CREATE TABLE LineStatusEntity (
    mode TEXT NOT NULL,
    line TEXT NOT NULL,
    statusSeverityDescription TEXT NOT NULL,
    reason TEXT,
    lastUpdatedTime TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY (mode, line)
);

-- Last time a backend payload (FCM push or REST refresh) was PROCESSED for
-- this (station, line) board, in epoch millis. Deliberately separate from
-- PredictionEntity.timestamp: that timestamp only exists if a row was
-- written, so a 0-row update (line quiet, service ended, empty direction)
-- would leave no record of "we just heard from the backend". This table is
-- upserted on EVERY sync regardless of row count, so the "X ago" timer can
-- honestly mean "time since the last backend update" even when that update
-- carried zero departures. One row per board.
CREATE TABLE SyncStatusEntity (
    stationId TEXT NOT NULL,
    lineId TEXT NOT NULL,
    -- Scoped per direction for the same reason as PredictionEntity: the two
    -- directions of one line are independent boards with their own "X ago".
    direction TEXT NOT NULL DEFAULT '',
    lastSyncMs INTEGER NOT NULL,
    PRIMARY KEY (stationId, lineId, direction)
);

-- The user's activity trail, queued locally and uploaded in batches on a
-- schedule. See `ActivityLog` for the contract.
--
-- ⚠️ Deliberately NOT cleared by `SqlStorage.clearAllData()`, which login and
-- logout both run. That is the whole reason this is a table and not part of the
-- existing wipe: the events worth having most are the ones AROUND an auth
-- change ("logged out", "logged in on a new device"), and a queue emptied by
-- the very event it is recording can never report it. `clearAllData` names its
-- tables explicitly rather than dropping everything, so this survives by
-- construction — keep it that way.
--
-- The `uid` is stamped at ENQUEUE time, not at upload: an event belongs to
-- whoever was signed in when it happened, and a queue that outlives a session
-- would otherwise attribute yesterday's activity to today's account. Blank for
-- an event recorded while signed out, which is uploaded under whoever signs in
-- next — the honest answer, since it happened on their device.
CREATE TABLE ActivityEventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    uid TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL,
    -- Device clock when the event happened, epoch millis.
    t INTEGER NOT NULL,
    -- JSON object of flat string properties.
    props TEXT NOT NULL DEFAULT '{}'
);

CREATE INDEX activity_by_time ON ActivityEventEntity(t);

-- Queries
insertSelection:
INSERT INTO UserSelectionEntity(mode, line, station, parentStationId, stationName, direction, destinations, destinationIds, filterMode, viaStationId, viaStationName, viaKeys, patternIds, patternNames, directionName, directionDestinations, directionTowards, routeResolvedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ORDER BY is load-bearing, not tidiness.
--
-- Boards a user has never dragged all tie at `BoardConfig.UNPOSITIONED`, and
-- `UserSettings.ordered` is a STABLE sort — so for those users the home screen's
-- order, and therefore "your first station", collapses to whatever order this
-- query happened to return. Without an ORDER BY that is undefined: SQLite is
-- free to change it, and `restoreFromCloud` clears the table and re-inserts, so
-- it demonstrably does.
--
-- Three surfaces read "first" off that order and every one of them means the
-- user's first: the widget's configuration picker, the gallery's
-- `recommendations()`, and the station a newly added widget takes. An
-- unrelated sync must not move any of them.
--
-- `id` is AUTOINCREMENT, so it is insertion order and never reused.
selectAllSelections:
SELECT * FROM UserSelectionEntity ORDER BY id;

clearSelections:
DELETE FROM UserSelectionEntity;

deleteSelection:
DELETE FROM UserSelectionEntity WHERE station = ? AND line = ? AND direction = ?;

insertPrediction:
INSERT OR REPLACE INTO PredictionEntity(stationId, lineId, direction, destination, destId, viaKey, matchesFilter, platform, eta, isDue, stopLetter, timestamp, targetEpochMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Board reads. Filtered rows are excluded in SQL off the precomputed flag, and
-- ordered here so the render path receives them ready to draw — it must do no
-- filtering and no sorting of its own.
--
-- targetEpochMs sorts NULLS LAST: a row whose ISO timestamp failed to parse
-- still has a usable `eta` string and must not jump to the head of the board.
getPredictionsForStation:
SELECT * FROM PredictionEntity
WHERE stationId = ? AND lineId = ? AND direction = ? AND matchesFilter = 1
ORDER BY targetEpochMs IS NULL, targetEpochMs;

-- Same board, filter ignored. Used for the fail-open fallback: when a filter
-- matches nothing right now, the board shows the unfiltered list with a note
-- rather than an empty card.
getAllPredictionsForStation:
SELECT * FROM PredictionEntity
WHERE stationId = ? AND lineId = ? AND direction = ?
ORDER BY targetEpochMs IS NULL, targetEpochMs;

getPredictionsTimestamp:
SELECT MAX(timestamp) AS lastTimestamp FROM PredictionEntity WHERE stationId = ? AND lineId = ? AND direction = ?;

clearPredictionsForStation:
DELETE FROM PredictionEntity WHERE stationId = ? AND lineId = ? AND direction = ?;

-- Every direction of a line at a station, regardless of how many directions of
-- it the user was tracking. Currently unused: teardown is direction-scoped
-- (discardStation removes one board), and removing a whole card iterates its
-- selections. Kept for the Android port, which still deletes per (station, line).
clearPredictionsForLine:
DELETE FROM PredictionEntity WHERE stationId = ? AND lineId = ?;

clearAllPredictions:
DELETE FROM PredictionEntity;

insertLineStatus:
INSERT OR REPLACE INTO LineStatusEntity(mode, line, statusSeverityDescription, reason, lastUpdatedTime, timestamp)
VALUES (?, ?, ?, ?, ?, ?);

getLineStatus:
SELECT * FROM LineStatusEntity WHERE mode = ? AND line = ?;

clearLineStatuses:
DELETE FROM LineStatusEntity;

upsertSyncStatus:
INSERT OR REPLACE INTO SyncStatusEntity(stationId, lineId, direction, lastSyncMs)
VALUES (?, ?, ?, ?);

getSyncStatus:
SELECT lastSyncMs FROM SyncStatusEntity WHERE stationId = ? AND lineId = ? AND direction = ?;

clearSyncStatuses:
DELETE FROM SyncStatusEntity;

-- ── Activity trail ──
--
-- OR IGNORE so re-recording an event that is already queued is a no-op rather
-- than a crash. The id is generated per event, so this only fires on a genuine
-- double-enqueue — which a lifecycle callback delivered twice will produce.
enqueueActivityEvent:
INSERT OR IGNORE INTO ActivityEventEntity(id, uid, name, t, props)
VALUES (?, ?, ?, ?, ?);

-- Oldest first, so a queue too long for one batch drains in the order things
-- happened and a device that has been offline for a week uploads that week in
-- sequence rather than newest-first with the tail perpetually behind.
--
-- Scoped by uid so one account's flush can never carry another's events. The
-- blank-uid rows are swept in with whoever is signed in — see the table note.
selectActivityBatch:
SELECT * FROM ActivityEventEntity
WHERE uid = ? OR uid = ''
ORDER BY t
LIMIT ?;

countActivityEvents:
SELECT COUNT(*) AS total FROM ActivityEventEntity;

oldestActivityEvent:
SELECT MIN(t) AS oldest FROM ActivityEventEntity;

deleteActivityEvent:
DELETE FROM ActivityEventEntity WHERE id = ?;

-- Drop the oldest rows when the queue outgrows its cap. Oldest rather than
-- newest because a queue this long means uploads have been failing for a long
-- time, and recent activity is the part still worth having.
trimActivityEvents:
DELETE FROM ActivityEventEntity WHERE id IN (
    SELECT id FROM ActivityEventEntity ORDER BY t LIMIT ?
);

clearActivityEvents:
DELETE FROM ActivityEventEntity;
