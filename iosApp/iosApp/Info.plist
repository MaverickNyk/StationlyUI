<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Stationly</string>
    <key>CFBundleDisplayName</key>
    <string>Stationly</string>
    <key>CFBundleIdentifier</key>
    <string>com.stationly.mobile</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- ── Deep linking ────────────────────────────────────────────── -->
    <!-- stationly://reset?oobCode=XXX  →  password reset              -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>stationly</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.stationly.mobile.deeplink</string>
        </dict>
        <!-- Google Sign-In reversed client ID URL scheme               -->
        <!-- Replace XXXXX with the actual value from GoogleService-Info.plist  -->
        <!-- Format: com.googleusercontent.apps.XXXXX                   -->
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>REPLACE_WITH_REVERSED_CLIENT_ID</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.stationly.mobile.google</string>
        </dict>
    </array>

    <!-- ── Google Sign-In ──────────────────────────────────────────── -->
    <!-- Replace with the reversed client ID from GoogleService-Info.plist      -->
    <key>GIDClientID</key>
    <string>REPLACE_WITH_REVERSED_CLIENT_ID</string>

    <!-- ── Permissions ────────────────────────────────────────────── -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Stationly uses your location to find nearby stations.</string>

    <!-- ── Background modes ───────────────────────────────────────── -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
